# BE 설정. 이 파일을 .env 로 복사해서 쓴다 (cp .env.example .env). 운영은 같은 이름을 서버 환경변수로 넣는다.
# 코드에 기본값이 없다 — 아래 항목이 하나라도 빠지면 BE 가 시작할 때 빠진 이름을 전부 알려주고 멈춘다 (config/RequiredEnv).
# 값은 로컬 개발용. <...> 는 직접 채운다.

# ── DB ── 로컬은 infra/local/docker-compose.yml 의 Postgres (bootRun 이 켠다)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=travelpass
DB_USER=postgres
DB_PASSWORD=postgres

# ── Keycloak ── keycloak-auth 레포 (로컬 8080)
# 직원 realm. 토큰의 iss 와 글자 하나까지 같아야 한다 (FE 의 KEYCLOAK_STAFF_ISSUER_URI 와 같은 값)
KEYCLOAK_STAFF_ISSUER_URI=http://localhost:8080/realms/crosshub
# 고객 realm (TP 앱 토큰). 빈 값이면 고객용 API 는 전부 401
KEYCLOAK_CUSTOMER_ISSUER_URI=http://localhost:8080/realms/idblock
# role 이 붙는 BE 이름표 client (토큰 aud·resource_access 키)
KEYCLOAK_AUDIENCE=tp-office-partner-api
# 계정 발급·비번 초기화·활성 토글용 service account. secret 은 keycloak-auth/.env 의 TP_OFFICE_PARTNER_SVC_CLIENT_SECRET 과 같은 값
KEYCLOAK_SVC_CLIENT_ID=tp-office-partner-svc
KEYCLOAK_SVC_CLIENT_SECRET=<keycloak-auth/.env 의 TP_OFFICE_PARTNER_SVC_CLIENT_SECRET>

# ── 인증 ──
# true 면 토큰 검증 없이 전부 허용 — 로컬 개발에서만. secure 프로필(운영)은 이 값을 무시하고 항상 검증한다
APP_AUTH_DISABLED=false
# 인증을 껐을 때만: 로그인한 것으로 칠 User.loginId (빈 값이면 전체 열람 가짜 사용자). 선택
APP_AUTH_DEV_LOGIN_ID=

# ── CORS ── 브라우저가 BE 를 직접 부르는 곳 (쉼표로 여러 개). FE 는 서버에서 부르므로 사실상 고객 앱·데모용
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Upstage (상품 번역·AI 검수·문의 번역·소개서 추출) ──
# 키가 빈 값이면: AI 검수는 건너뛰고, 번역·소개서는 UPSTAGE_FAKE_WHEN_MISSING 에 따라 가짜 값("[ko] 원문"·샘플) 또는 실패
UPSTAGE_API_KEY=
# 소개서 추출 전용 키 (과금 구분용). 빈 값이면 UPSTAGE_API_KEY 를 같이 쓴다
UPSTAGE_DOCS_API_KEY=
# 키가 없을 때 가짜 값으로 돌지. 로컬 true, 운영 false (secure 프로필은 false 로 고정 — 그때 키가 비어 있으면 시작하지 않는다)
UPSTAGE_FAKE_WHEN_MISSING=true
# Solar 호출 최소 간격(ms). 호출 제한을 확인하면 조정
SOLAR_MIN_INTERVAL_MS=0

# ── 파일 저장소 (S3 프로토콜) ── 로컬은 RustFS (bootRun 이 켠다, 콘솔 http://localhost:9001)
# Supabase: S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3, S3_PUBLIC_URL=https://xxxx.supabase.co/storage/v1/object/public/<bucket>
# NCP:      S3_ENDPOINT=https://kr.object.ncloudstorage.com, S3_REGION=kr-standard
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=product-images
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# 공개 URL 앞부분. DB 에는 저장소 안 경로만 있고, 응답 URL 은 이 값 + "/" + 경로로 만든다
S3_PUBLIC_URL=http://localhost:9000/product-images

# ── 로컬 개발 도구 ── bootRun 이 로컬 DB·저장소 컨테이너를 켤지. 원격 DB 로 띄울 땐 false (배포 jar 에는 이 기능이 없다)
DOCKER_COMPOSE_ENABLED=true
