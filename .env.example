# DB — 로컬은 infra/local/docker-compose.yml의 Postgres (포트 5433, DB travelpass)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=travelpass
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak (crosshub realm)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/crosshub
# 고객 realm issuer (TP 앱·demo/tp-web 토큰). 기본값 그대로면 생략 가능
# KEYCLOAK_CUSTOMER_ISSUER_URI=http://localhost:8080/realms/idblock
# role 이 붙는 BE 이름표 client (토큰 aud·resource_access 키). 기본 backoffice-api — 보통 바꿀 일 없음
# KEYCLOAK_APP_CLIENT_ID=backoffice-api

# dev 모드(토큰 검증 없이 전부 허용). 로컬 개발에서만 true. 비우면 false(검증 켜짐)
APP_DEV_ENABLED=false

# FE 주소 (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 고객 로그인 데모(idblock-auth/demo/tp-web)를 같이 띄우면 http://localhost:5173 도 추가

# 계정 발급·비번 초기화·활성 토글 (Keycloak Admin API, backoffice-admin-api service account). 필수
KEYCLOAK_ADMIN_CLIENT_ID=backoffice-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=
