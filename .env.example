# DB (v1 Prisma가 쓰던 Postgres 그대로)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak (crosshub realm)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/crosshub

# dev 모드(토큰 검증 없이 전부 허용). 로컬 개발에서만 true. 비우면 false(검증 켜짐)
APP_DEV_ENABLED=false

# FE 주소 (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000
