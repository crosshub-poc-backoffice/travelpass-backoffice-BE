# DB — 로컬은 infra/local/docker-compose.yml의 Postgres (포트 5433, DB travelpass)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=travelpass
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak (crosshub realm)
KEYCLOAK_STAFF_ISSUER_URI=http://localhost:8080/realms/crosshub
# 고객 realm issuer (TP 앱·demo/tp-web 토큰). 기본값 그대로면 생략 가능
# KEYCLOAK_CUSTOMER_ISSUER_URI=http://localhost:8080/realms/idblock
# role 이 붙는 BE 이름표 client (토큰 aud·resource_access 키). 기본 backoffice-api — 보통 바꿀 일 없음
# KEYCLOAK_AUDIENCE=backoffice-api

# 인증 끄기(토큰 검증 없이 전부 허용). 로컬 개발에서만 true. 비우면 false(검증 켜짐)
APP_AUTH_DISABLED=false
# 인증을 껐을 때 로그인한 것으로 칠 User.loginId. 비우면 전체 열람 가짜 사용자
# APP_AUTH_DEV_LOGIN_ID=

# FE 주소 (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 고객 로그인 데모(keycloak-auth/demo/tp-web)를 같이 띄우면 http://localhost:5173 도 추가

# 계정 발급·비번 초기화·활성 토글 (Keycloak Admin API, backoffice-svc service account). 필수
KEYCLOAK_SVC_CLIENT_ID=backoffice-svc
KEYCLOAK_SVC_CLIENT_SECRET=

# 상품 번역·AI 검수 (Upstage Solar). 로컬에서 비우면 "[en] 원문" 가짜 번역으로 돌고 AI 검수는 건너뛴다. 배포는 키 필수
# UPSTAGE_API_KEY=
# 배포에서 키가 빠졌을 때 가짜 번역으로 조용히 넘어가지 않게 끈다
# UPSTAGE_FAKE_WHEN_MISSING=false
